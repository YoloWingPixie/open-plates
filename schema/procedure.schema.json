          }
        },
        {
          "if": { "properties": { "procedure_type": { "const": "airport_diagram" } }, "required": ["procedure_type"] },
          "then": { "required": ["airport_diagram"] }
        },
        {
          "if": {
            "properties": { "procedure_type": { "enum": ["sid", "star"] } },
            "required": ["procedure_type"]
          },
          "then": { "required": ["procedure_computer_code"] }
        }
      ],

      "additionalProperties": false
    }
  }
